theme = ExtResource("3_mtvw0")
text = "Hire those with relevant experience.
RELEVANT JOBS:
Computer Scientist, Game, Developer, Digital Artist, Storyboard Artist, Quality Assurer, Playtester,
Soundtrack Designer, SFX Designer, Coder

Despite their best efforts, there is no warrant for our arrest. Do not accept:
FBI Agents, OSHA employees

All other jobs are irrelevant."
autowrap_mode = 3

[node name="Skills" type="Label" parent="." unique_id=1600498268]
custom_minimum_size = Vector2(380, 0)
layout_mode = 0
offset_left = 94.0
offset_top = 290.0
offset_right = 474.0
offset_bottom = 862.0
theme = ExtResource("3_mtvw0")
text = "Each applicant must name at least three seperate skills.
Some skills are just different phrasings, and do NOT count.
Accept only those with three different skills.

Some people pass off crime as a skill. These are:
Tool Reallocator
Crime Doer"
autowrap_mode = 3

[node name="Colleges" type="Label" parent="." unique_id=1171681576]
custom_minimum_size = Vector2(380, 0)
layout_mode = 0
offset_left = 493.0
offset_top = 36.0
offset_right = 879.0
offset_bottom = 286.0
theme = ExtResource("3_mtvw0")
text = "We only accept the highest quality universities. They are:
Prestige U., James Baker U., Citadel U., Knowledge U., Serpent U., Helios Tech., Spirit College

Acceptable, but not outstanding Universities: 
College U., Community College, Heart College, Mountain Tech

Avoid degree mills where people get fake degrees. These are only acceptable in upper management.
DO NOT ACCEPT:
Community U., John College"
autowrap_mode = 3

[node name="Reasons" type="Label" parent="." unique_id=488663719]
